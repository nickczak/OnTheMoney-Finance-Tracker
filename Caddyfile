# Production web server for https://onthemoney.site
#
# Serves the static React/Vite PWA from /opt/onthemoney/web/dist and
# reverse-proxies /api/* to the Spring Boot backend on localhost:8080.
#
# Caddy automatically provisions and renews the Let's Encrypt TLS
# certificate for onthemoney.site - no certbot/nginx SSL config needed.
#
# Install:  sudo apt install caddy && sudo cp Caddyfile /etc/caddy/Caddyfile
# Restart:  sudo systemctl reload caddy

onthemoney.site, www.onthemoney.site {
	# Route /api/* to the Spring Boot backend.
	handle /api/* {
		reverse_proxy localhost:8080
	}

	# Serve the built PWA from disk (transferred by the deploy workflow).
	handle {
		root * /opt/onthemoney/web/dist
		# SPA fallback: any non-file route (e.g. /accounts, /stocks) served
		# by React Router gets index.html so client-side routing and
		# hard refreshes don't 404.
		try_files {path} {path}/ /index.html
		file_server
		encode gzip zstd
	}

	# Sensible caching: hashed build assets are immutable, index.html is not.
	header @static /assets/* Cache-Control "public, max-age=31536000, immutable"
	header -Server
}
