# Database
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Finnhub (get from https://finnhub.io/register)
FINNHUB_API_KEY=your_finnhub_api_key

# NVD API key for OWASP Dependency-Check (get from https://nvd.nist.gov/developers/request-an-api-key)
# Or set in ~/.gradle/gradle.properties as nvdApiKey
NVD_API_KEY=
