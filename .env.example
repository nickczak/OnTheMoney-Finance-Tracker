# Database
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Finnhub (get from https://finnhub.io/register)
FINNHUB_API_KEY=your_finnhub_api_key

# Plaid (get from https://dashboard.plaid.com/signup)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
# Optional legacy setting; webhook requests are verified with Plaid's signed JWT instead.
PLAID_WEBHOOK_SECRET=
PLAID_ENV=sandbox # or production
PLAID_WEBHOOK_URL=https://onthemoney.site/api/plaid/webhook
PLAID_REDIRECT_URI=https://onthemoney.site/accounts
# Generate with: openssl rand -base64 48
APPLICATION_SECRET=your_application_secret
